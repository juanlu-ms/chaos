{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "local-env",
      "displayName": "Local Environment Overrides",
      "description": "Local-only environment settings (override via CMakeUserPresets.json)",
      "environment": {
        "VCPKG_ROOT": "$penv{VCPKG_ROOT}"
      }
    },
    {
      "name": "base-clang",
      "description": "Base Clang preset",
      "hidden": true,
      "inherits": [
        "local-env"
      ],
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_FEATURE_FLAGS": "manifests",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "dev-linux-clang",
      "displayName": "Linux Clang (Debug)",
      "inherits": [
        "base-clang"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-linux-clang",
      "displayName": "Linux Clang (Release)",
      "inherits": [
        "base-clang"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-asan-ubsan",
      "displayName": "CI ASan/UBSan (Debug, isolated)",
      "inherits": [
        "dev-linux-clang"
      ],
      "cacheVariables": {
        "CHAOS_ENABLE_ASAN_UBSAN": "ON"
      }
    },
    {
      "name": "ci-tsan",
      "displayName": "CI TSan (Debug, isolated)",
      "inherits": [
        "dev-linux-clang"
      ],
      "cacheVariables": {
        "CHAOS_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "ci-coverage",
      "displayName": "CI Coverage (Debug, isolated)",
      "inherits": [
        "dev-linux-clang"
      ],
      "cacheVariables": {
        "CHAOS_ENABLE_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "dev-linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release-linux-clang",
      "configuration": "Release"
    },
    {
      "name": "debug-asan",
      "configurePreset": "ci-asan-ubsan",
      "configuration": "Debug"
    },
    {
      "name": "debug-tsan",
      "configurePreset": "ci-tsan",
      "configuration": "Debug"
    },
    {
      "name": "debug-cov",
      "configurePreset": "ci-coverage",
      "configuration": "Debug"
    },
    {
      "name": "check-format",
      "configurePreset": "dev-linux-clang",
      "configuration": "Debug",
      "targets": [
        "check-format"
      ]
    },
    {
      "name": "format",
      "configurePreset": "dev-linux-clang",
      "configuration": "Debug",
      "targets": [
        "format"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "configurePreset": "dev-linux-clang",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "test-release",
      "configurePreset": "release-linux-clang",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "test-asan",
      "configurePreset": "ci-asan-ubsan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "test-tsan",
      "configurePreset": "ci-tsan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "check-format",
      "steps": [
        {
          "name": "dev-linux-clang",
          "type": "configure"
        },
        {
          "name": "check-format",
          "type": "build"
        }
      ]
    },
    {
      "name": "format",
      "steps": [
        {
          "name": "dev-linux-clang",
          "type": "configure"
        },
        {
          "name": "format",
          "type": "build"
        }
      ]
    }
  ]
}
