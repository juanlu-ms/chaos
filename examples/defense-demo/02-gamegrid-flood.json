{
  "test_name": "GameGrid - Ataque DDoS (packet_flood + traffic_corruption)",
  "target": {
    "id": "chaos-demo-api"
  },
  "duration_s": 12,
  "perturbations": [
    {
      "type": "packet_flood",
      "parameters": {
        "rate": "5000",
        "packet_size": "512"
      }
    },
    {
      "type": "traffic_corruption",
      "parameters": {
        "corrupt_pct": "10%",
        "loss_pct": "10%",
        "duplicate_pct": "5%"
      }
    }
  ],
  "expectations": [
    {
      "type": "container_running"
    },
    {
      "type": "http_status",
      "parameters": {
        "port": "8000",
        "path": "/ping",
        "expected_status": "200"
      }
    },
    {
      "type": "http_latency",
      "parameters": {
        "port": "8000",
        "path": "/ping",
        "max_latency_ms": "100"
      }
    }
  ]
}
