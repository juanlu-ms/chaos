{
  "test_name": "Resource Exhaustion Demo",
  "target": {
    "id": "chaos-demo-1"
  },
  "duration_s": 15,
  "perturbations": [
    {
      "type": "cpu_cap",
      "parameters": {
        "cpu_cores": "0.1"
      }
    },
    {
      "type": "memory_cap",
      "parameters": {
        "limit_bytes": "268435456"
      }
    }
  ],
  "expectations": [
    {
      "type": "container_running"
    },
    {
      "type": "http_status",
      "parameters": {
        "port": "8000",
        "path": "/ping",
        "expected_status": "200"
      }
    }
  ]
}
