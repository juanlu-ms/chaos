{
    "test_name": "Network Delay Demo",
    "target": {
        "id": "chaos-demo-1"
    },
    "duration_s": 10,
    "perturbations": [
        {
            "type": "network_delay",
            "parameters": {
                "delay_ms": "500"
            }
        }
    ],
    "expectations": [
        {
            "type": "container_running"
        },
        {
            "type": "http_latency",
            "parameters": {
                "port": "8080",
                "path": "/ping",
                "min_latency_ms": "400",
                "max_latency_ms": "2000"
            }
        }
    ]
}
