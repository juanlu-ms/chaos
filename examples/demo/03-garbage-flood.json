{
    "test_name": "Packet Flood Demo",
    "target": {
        "id": "chaos-demo-1"
    },
    "duration_s": 10,
    "perturbations": [
        {
            "type": "packet_flood",
            "parameters": {
                "rate": "1000",
                "packet_size": "128"
            }
        }
    ],
    "expectations": [
        {
            "type": "container_running"
        },
        {
            "type": "http_status",
            "parameters": {
                "port": "8080",
                "path": "/ping",
                "expected_status": "200"
            }
        }
    ]
}
